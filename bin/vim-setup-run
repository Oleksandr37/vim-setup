#!/usr/bin/env bash
set -euo pipefail

pool_session="${VIM_SETUP_POOL_SESSION:-__workon_pool}"

usage() {
  printf 'Usage: vim-setup-run --root PATH -- COMMAND\n       vim-setup-run --stop --root PATH\n' >&2
  exit 2
}

normalize_root() {
  local root="$1"
  root="$(cd "$root" && pwd -P)"
  if git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1; then
    root="$(git -C "$root" rev-parse --show-toplevel)"
  fi
  printf '%s\n' "$root"
}

unique_panes() {
  tmux list-panes -a -F '#{pane_id}|#{@vim_setup_path}|#{@vim_setup_deck}|#{@vim_setup_name}' |
    awk -F'|' '!seen[$1]++'
}

named_runner() {
  local root="$1"
  unique_panes | awk -F'|' -v root="$root" '$2 == root && $3 == "terminal" && $4 == "runner" { print $1; exit }'
}

workspace_window() {
  local root="$1"
  tmux list-windows -t "$pool_session" -F '#{window_id}|#{@vim_setup_path}' |
    awk -F'|' -v root="$root" '$2 == root { print $1; exit }'
}

visible_terminal() {
  local root="$1" window
  window="$(workspace_window "$root")"
  [[ -n "$window" ]] || return 0
  tmux list-panes -t "$window" -F '#{pane_id}|#{@vim_setup_deck}' |
    awk -F'|' '$2 == "terminal" { print $1; exit }'
}

activate_runner() {
  local root="$1" runner visible window position
  runner="$(named_runner "$root")"
  visible="$(visible_terminal "$root")"
  [[ -n "$runner" && -n "$visible" ]] || return 1
  if [[ "$runner" != "$visible" ]]; then
    tmux swap-pane -d -s "$runner" -t "$visible"
  fi
  window="$(workspace_window "$root")"
  position="$(tmux show-option -pqv -t "$runner" @vim_setup_position)"
  tmux set-option -w -t "$window" @vim_setup_terminal_position "$position"
  tmux select-pane -t "$runner"
  printf '%s\n' "$runner"
}

[[ -n "${TMUX:-}" ]] || { printf 'vim-setup-run must be called from inside tmux.\n' >&2; exit 1; }

stop=false
root=""
if [[ "${1:-}" == "--stop" ]]; then
  stop=true
  shift
fi
[[ "${1:-}" == "--root" && -n "${2:-}" ]] || usage
root="$(normalize_root "$2")"
shift 2

if $stop; then
  [[ $# -eq 0 ]] || usage
  pane="$(named_runner "$root")"
  [[ -n "$pane" ]] || { printf 'No runner pane found for %s.\n' "$root" >&2; exit 1; }
  tmux send-keys -t "$pane" C-c
  exit 0
fi

[[ "${1:-}" == "--" && -n "${2:-}" && $# -eq 2 ]] || usage
command="$2"
pane="$(activate_runner "$root")" || { printf 'No runner pane found for %s.\n' "$root" >&2; exit 1; }

printf -v quoted_root '%q' "$root"
tmux send-keys -t "$pane" C-c
tmux send-keys -t "$pane" -l "cd -- $quoted_root && $command"
tmux send-keys -t "$pane" Enter
